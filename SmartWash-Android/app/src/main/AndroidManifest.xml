<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--  网络权限  -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--  通知权限（APK 下载进度通知栏展示，Android 13+ 需运行时授权）  -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--  前台服务权限（APK 下载 Worker 提升为前台服务保活，Android 14+ 需声明 foregroundServiceType）  -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!--  安装未知应用权限与 APK FileProvider 已随热更新链路迁 :feature:update（T3.1，manifest merger 合入）  -->

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartWashAndroid"
        tools:targetApi="31">
        <activity
            android:name=".ui.activity.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartWashAndroid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--  WorkManager 改按需初始化（App 实现 Configuration.Provider 注入 HiltWorkerFactory，
              供 :feature:update 的 @HiltWorker ApkDownloadWorker 实例化）：
              移除默认 initializer，否则其抢先以默认配置初始化，App 的配置永不生效  -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>