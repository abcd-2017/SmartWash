<?xml version="1.0" encoding="utf-8"?>
<!--
    云备份规则（Android 11 及以下生效；Android 12+ 见 data_extraction_rules.xml）。
    排除 DataStore（内含登录 token）与 SharedPreferences，避免登录凭证随云备份外泄。
-->
<full-backup-content>
    <exclude domain="file" path="datastore/" />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
