<?xml version="1.0" encoding="utf-8"?>
<!--
    数据提取规则（Android 12+ 生效）。
    云备份与设备迁移均排除 DataStore（内含登录 token）与 SharedPreferences，
    避免登录凭证随备份外泄。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
