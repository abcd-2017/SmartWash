<?xml version="1.0" encoding="utf-8"?>
<!--
    网络安全配置：默认禁止明文流量，仅对 demo 后端服务器（8.148.70.81）放行明文 HTTP。
    debug 与 release 共用本配置（演示服务器为 http）。
    生产发布切换 HTTPS 域名后，删除下方 domain-config 明文放行。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">8.148.70.81</domain>
    </domain-config>
</network-security-config>
