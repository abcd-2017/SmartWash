<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!--
    APK 安装包落盘在 filesDir/update（见 ApkDownloadWorker.apkDir），
    故此处用 files-path 精确指向 update/ 子目录，不再沿用 cacheDir。

    path 写成 "update/"（而非省略）：省略时 root = filesDir 本身，虽然仍能匹配
    update/ 下的文件，但会把整个 filesDir 都暴露给 FileProvider 授权范围；
    收窄到 update/ 子目录可减小 URI 授权面。不要用 "."——尾部 "/." 会导致
    「Failed to find configured root」，使点击通知安装入口失效。
    -->
    <files-path name="update_apks" path="update/" />
</paths>
