<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartwash.mapper.DashboardMapper">

    <!-- 项目仅 payments/recharge_records 启用逻辑删除（is_delete 列），其余表仍为物理删除 -->
    <select id="countSchools" resultType="java.lang.Long">
        SELECT COUNT(*) FROM schools
    </select>

    <select id="countUsers" resultType="java.lang.Long">
        SELECT COUNT(*) FROM users
    </select>

    <select id="countTodayOrders" resultType="java.lang.Long">
        SELECT COUNT(*) FROM orders WHERE created_at >= #{todayStart}
    </select>

    <!-- 收入统计必须排除已逻辑删除的支付流水，否则删掉的流水仍计入收入 -->
    <select id="sumTodayIncome" resultType="java.math.BigDecimal">
        SELECT IFNULL(SUM(amount), 0) FROM payments
        WHERE status = '1' AND paid_at >= #{todayStart} AND is_delete = 0
    </select>

</mapper>
