<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartwash.notice.mapper.NoticeReadMapper">

    <!-- 全平台用户总数（送达统计分母）：v1 公告对全部用户可见，无定向推送 -->
    <select id="countUsers" resultType="long">
        select count(*) from users
    </select>

    <!-- 某条公告已读人数：uk_user_notice 保证一人一条，直接 count 即去重 -->
    <select id="countReadByNotice" resultType="long">
        select count(*) from notice_read where notice_id = #{noticeId}
    </select>
</mapper>
