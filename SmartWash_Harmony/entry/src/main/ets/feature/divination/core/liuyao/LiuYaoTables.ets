/** 六神起例：甲乙起青龙，丙丁起朱雀，戊起勾陈，己起螣蛇，庚辛起白虎，壬癸起玄武（自初爻起顺轮） */
export const SHEN6: string[] = ['青龙', '朱雀', '勾陈', '螣蛇', '白虎', '玄武'];

/** 六神轮转起点（按日干序：甲乙0 丙丁1 戊2 己3 庚辛4 壬癸5） */
export const SHEN6_ROTATION: number[] = [0, 0, 1, 1, 2, 3, 4, 4, 5, 5];

/** 六亲生克：同我兄弟，我生子孙，我克妻财，克我官鬼，生我父母（以卦宫五行为"我"） */
export const QING6: string[] = ['兄弟', '父母', '官鬼', '妻财', '子孙'];

/** 六合卦名片段（卦名含之即六合） */
export const LIUHE_FRAGMENTS: string[] = ['否', '困', '旅', '豫', '节', '贲', '复', '泰'];

/** 取卦名，缺失即抛错（对齐安卓 GUA64.getValue） */
export function guaNameOf(mark: string): string {
  const name = GUA64[mark];
  if (name === undefined) {
    throw new Error(`未知卦码: ${mark}`);
  }
  return name;
}
