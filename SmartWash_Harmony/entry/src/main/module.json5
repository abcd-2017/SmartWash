{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "routerMap": "$profile:router_map",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:logo",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:logo",
        "startWindowBackground": "$color:start_window_background",
        // 方向锁定竖屏（对齐安卓 manifest screenOrientation="portrait"；module schema 支持该字段）
        "orientation": "portrait",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          },
          {
            // 深链接收（对齐安卓 intent-filter scheme="smartwash"）：
            // action/entity 取值对齐 wantConstant.ACTION_VIEW_DATA / ENTITY_BROWSABLE；
            // uris 仅声明 scheme、host 缺省 = 任意 host 均可匹配（鸿蒙 Deep Link 规范：
            // host 省略时按通配处理，无需写 "*"）。onCreate/onNewWant 消费链路见 EntryAbility。
            "entities": [
              "entity.system.browsable"
            ],
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "smartwash"
              }
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ]
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET",
        "reason": "$string:internet_reason"
      },
      {
        // 实验舱掌上星图：加速度计读取设备姿态（system_grant 普通权限，免弹窗）。
        // 磁力计（SensorId.MAGNETIC_FIELD）无需权限：SDK @ohos.sensor.d.ts 的
        // MAGNETIC_FIELD 订阅无 @permission 标注，且该权限名不在 SDK 白名单内
        // （声明会报 00303221 构建失败），不要尝试为磁力计追加 requestPermissions
        "name": "ohos.permission.ACCELEROMETER",
        "reason": "$string:accelerometer_reason"
      }
    ]
  }
}